# The single source of MQTT stand parameters. Plain KEY=VALUE, no quotes or expansion, because both
# bash (`. stand.env`, emulator/stand/lib.sh) and Python (ci/stand.py) read this file.
# Everything else -- broker config, ACL, certificates, passwords, edge.conf -- is generated from it
# by lib.sh into a throwaway directory; nothing derived from it is committed.
# The credentials are test-only and only ever meet a broker started for a test.

BROKER_PORT=8883

# Network root + hierarchy path, the same shape as the Android app's defaults ("mesh-a" +
# "7F10/21A0"); edge publishes under <TOPIC_ROOT>/telemetry/..., the app subscribes to <TOPIC_ROOT>/#.
TOPIC_ROOT=mesh-a/7F10/21A0

EDGE_USER=edge
EDGE_PASS=edge-test-pw
APP_USER=app
APP_PASS=app-test-pw

# emulator/stand/smoke.sh: an identity with a grant on SMOKE_ROOT and one with none at all.
SMOKE_ROOT=mes/smoke
AUTH_USER=authorized
AUTH_PASS=authorized-test-pw
STRANGER_USER=stranger
STRANGER_PASS=stranger-test-pw
