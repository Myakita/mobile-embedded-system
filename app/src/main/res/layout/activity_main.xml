<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/space_12">

    <!-- 1. Верхний приборный рельс (ТЗ §6.6: высота 28dp) -->
    <!-- Верхний приборный рельс: статус-бар и ориентация (ТЗ §6.6, §6.10) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_12">

        <!-- Кнопка переключения ориентации North-Up / Track-Up -->
        <TextView
            android:id="@+id/btnMapOrientation"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="?attr/appSurface"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_8"
            android:text="КУРС: СЕВЕР"
            android:textColor="?attr/appInk"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnExportSession"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/space_8"
            android:background="?attr/appSurface"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_8"
            android:text="GPX"
            android:textColor="?attr/appInk"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textCoords"
            style="@style/Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--.-----° N  --.-----° E"
            android:textColor="?attr/appInk" />
    </LinearLayout>

    <!-- Аварийный баннер эскалации инцидента (ТЗ §6.7: высота 32dp, нулевой радиус) -->
    <LinearLayout
        android:id="@+id/bannerEmergency"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/space_4"
        android:background="@color/status_emergency_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        android:visibility="gone">

        <TextView
            android:id="@+id/textEmergencyTitle"
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ТРЕВОГА: БОЕЦ [1002] • ТАХИКАРДИЯ"
            android:textColor="@color/status_emergency_text"
            android:textSize="12sp" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ФОКУС [TAP]"
            android:textColor="@color/status_emergency_text"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline_width"
        android:background="?attr/appHairline"
        android:layout_marginVertical="@dimen/space_8" />

    <!-- 2. Тактическая карта MapLibre -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline_width"
        android:background="?attr/appHairline"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8" />

    <!-- 3. Нижняя панель телеметрии и отряда (ТЗ §6.7–§6.9) -->
    <LinearLayout
        android:id="@+id/panelTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appSurface"
        android:orientation="vertical"
        android:padding="@dimen/space_8">

        <!-- Селектор бойцов группы (ТЗ §6.6, §6.8) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnUnit1001"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/appBg"
                android:gravity="center"
                android:text="[1001] КМД"
                android:textColor="?attr/appInk" />

            <View
                android:layout_width="@dimen/space_4"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/btnUnit1002"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/appBg"
                android:gravity="center"
                android:text="[1002] СТР"
                android:textColor="?attr/appInk" />

            <View
                android:layout_width="@dimen/space_4"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/btnUnit1003"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/appBg"
                android:gravity="center"
                android:text="[1003] САН"
                android:textColor="?attr/appInk" />
        </LinearLayout>

        <!-- Заголовок активного бойца и индикатор статуса -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewStatusIndicator"
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="?attr/appStatusOk" />

            <TextView
                android:id="@+id/textCallsign"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="БОЕЦ [1001] • КОМАНДИР"
                android:textColor="?attr/appInk"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textLinkStatus"
                style="@style/Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СВЯЗЬ: MESH-A"
                android:textColor="?attr/appInk2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Навигационная строка Range & Bearing (ТЗ §6.10, §6.13) -->
        <TextView
            android:id="@+id/textRangeBearing"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginStart="12dp"
            android:text="ДИСТ: -- м  |  ПЕЛЕНГ: ---°"
            android:textColor="?attr/appInk2"
            android:textSize="11sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_width"
            android:background="?attr/appHairline"
            android:layout_marginVertical="@dimen/space_8" />

        <!-- Физиологические показатели -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ПУЛЬС" />
                <TextView
                    android:id="@+id/textPulse"
                    style="@style/Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- BPM"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ТЕМП" />
                <TextView
                    android:id="@+id/textTemperature"
                    style="@style/Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--.- °C"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ДАВЛЕНИЕ" />
                <TextView
                    android:id="@+id/textPressure"
                    style="@style/Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---/-- mmHg"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_width"
            android:background="?attr/appHairline"
            android:layout_marginVertical="@dimen/space_8" />

        <!-- Селектор режимов отображения -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnThemeDay"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="?attr/appBg"
                android:gravity="center"
                android:text="ДЕНЬ"
                android:textColor="?attr/appInk" />

            <View
                android:layout_width="@dimen/space_4"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/btnThemeInstrument"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="?attr/appBg"
                android:gravity="center"
                android:text="ПРИБОР"
                android:textColor="?attr/appInk" />

            <View
                android:layout_width="@dimen/space_4"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/btnThemeBlackout"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="?attr/appBg"
                android:gravity="center"
                android:text="МАСКИРОВКА"
                android:textColor="?attr/appInk" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>