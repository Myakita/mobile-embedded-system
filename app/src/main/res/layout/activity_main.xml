<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg"
    android:orientation="vertical"
    android:padding="@dimen/space_12">

    <!-- Верхний информационный рельс (ТЗ §6.6: высота 28dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_rail_height"
        android:background="?attr/appSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8">

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="КАРТА ОБСТАНОВКИ" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textCoords"
            style="@style/Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ОФФЛАЙН КЭШ"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Разделитель hairline (ТЗ §6.6: 1dp) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline_width"
        android:background="?attr/appHairline"
        android:layout_marginBottom="@dimen/space_8" />

    <!-- Окно карты MapLibre (ТЗ §4.2, §6.10) -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>